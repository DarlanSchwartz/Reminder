<UserControl x:Class="Reminder.EditorPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource Canvas}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <UniformGrid x:Name="Progress" Rows="1" Margin="20,14,20,14"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,0,20,0"><StackPanel Margin="0,0,0,8">

  <!-- Step 1: the task -->
  <StackPanel x:Name="TaskStep">
   <Label Content="Nome da tarefa" Target="{Binding ElementName=TitleInput}" Padding="0,0,0,6" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
   <TextBox x:Name="TitleInput" Height="40" VerticalContentAlignment="Center" MaxLength="160"/>
   <Label Content="Descrição · opcional" Target="{Binding ElementName=DescriptionInput}" Padding="0" Margin="0,14,0,6" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
   <TextBox x:Name="DescriptionInput" Height="64" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000"/>
   <Label Content="Terminar até · opcional" Target="{Binding ElementName=DueInput}" Padding="0" Margin="0,14,0,6" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
   <DatePicker x:Name="DueInput"/>
  </StackPanel>

  <!-- Step 2: when -->
  <StackPanel x:Name="WhenStep" Visibility="Collapsed">
   <Border Style="{StaticResource Card}" Padding="14,12">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource AccentSoft}"><TextBlock Text="&#xEA8F;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Accent}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <StackPanel Grid.Column="1" Margin="11,0" VerticalAlignment="Center"><TextBlock Text="Me lembrar com um alarme" FontWeight="SemiBold" FontSize="13.5"/><TextBlock Text="Aviso em tela cheia, com som" FontSize="11.5" Foreground="{StaticResource Muted}"/></StackPanel>
     <CheckBox x:Name="AlarmEnabled" Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Center" Checked="ToggleAlarm" Unchecked="ToggleAlarm" AutomationProperties.Name="Me lembrar com um alarme"/>
    </Grid>
   </Border>
   <StackPanel x:Name="AlarmFields" Visibility="Collapsed" Margin="0,16,0,0">
    <TextBlock Text="Atalhos" Style="{StaticResource FieldLabel}"/>
    <WrapPanel>
     <Button Content="Em 1 hora" Style="{StaticResource Pill}" Click="QuickInHour"/>
     <Button Content="Hoje às 20:00" Style="{StaticResource Pill}" Click="QuickTonight"/>
     <Button Content="Amanhã às 09:00" Style="{StaticResource Pill}" Click="QuickTomorrow"/>
    </WrapPanel>
    <TextBlock Text="Data e horário" Style="{StaticResource FieldLabel}" Margin="0,10,0,6"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
     <DatePicker x:Name="AlarmDate" SelectedDateChanged="AlarmDateChanged"/>
     <TextBox x:Name="AlarmTime" Height="38" VerticalContentAlignment="Center" TextAlignment="Center" Grid.Column="1" Text="09:00" Margin="8,0,0,0" MaxLength="5" TextChanged="AlarmTimeChanged" LostKeyboardFocus="NormalizeAlarmTime" PreviewTextInput="FilterAlarmTime" ToolTip="Horário de 00:00 a 23:59. Ex.: 930 vira 09:30." AutomationProperties.Name="Horário do alarme"/>
    </Grid>
   </StackPanel>
  </StackPanel>

  <!-- Step 3: repeat -->
  <StackPanel x:Name="RepeatStep" Visibility="Collapsed">
   <TextBlock Text="Repetir" Style="{StaticResource FieldLabel}"/>
   <ComboBox x:Name="RepeatMode" SelectedIndex="0" SelectionChanged="RepeatChanged" AutomationProperties.Name="Repetir">
    <ComboBoxItem Content="Não repetir"/>
    <ComboBoxItem Content="Por hora"/>
    <ComboBoxItem Content="Diariamente"/>
    <ComboBoxItem Content="Semanalmente"/>
    <ComboBoxItem Content="Mensalmente"/>
    <ComboBoxItem Content="Anualmente"/>
   </ComboBox>
   <StackPanel x:Name="RepeatFields" Visibility="Collapsed">
    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
     <TextBlock Text="A cada" VerticalAlignment="Center" FontSize="13" Margin="0,0,10,0"/>
     <Button Content="&#xE738;" Style="{StaticResource IconButton}" FontSize="11" Width="32" Height="32" Click="DecreaseInterval" ToolTip="Menos" AutomationProperties.Name="Diminuir intervalo"/>
     <TextBox x:Name="IntervalInput" Width="54" Height="36" Text="1" TextAlignment="Center" VerticalContentAlignment="Center" MaxLength="3" Margin="4,0" PreviewTextInput="FilterDigits" TextChanged="RepeatInputChanged" AutomationProperties.Name="Intervalo da repetição"/>
     <Button Content="&#xE710;" Style="{StaticResource IconButton}" FontSize="11" Width="32" Height="32" Click="IncreaseInterval" ToolTip="Mais" AutomationProperties.Name="Aumentar intervalo"/>
     <TextBlock x:Name="IntervalUnit" Text="dias" VerticalAlignment="Center" FontSize="13" Margin="10,0,0,0"/>
    </StackPanel>
    <StackPanel x:Name="WeekFields" Visibility="Collapsed" Margin="0,14,0,0">
     <TextBlock Text="Nos dias" Style="{StaticResource FieldLabel}"/>
     <StackPanel x:Name="DayChips" Orientation="Horizontal">
      <ToggleButton Content="D" Tag="0" Style="{StaticResource DayChip}" ToolTip="Domingo" AutomationProperties.Name="Domingo" Click="DayToggled"/>
      <ToggleButton Content="S" Tag="1" Style="{StaticResource DayChip}" ToolTip="Segunda-feira" AutomationProperties.Name="Segunda-feira" Click="DayToggled"/>
      <ToggleButton Content="T" Tag="2" Style="{StaticResource DayChip}" ToolTip="Terça-feira" AutomationProperties.Name="Terça-feira" Click="DayToggled"/>
      <ToggleButton Content="Q" Tag="3" Style="{StaticResource DayChip}" ToolTip="Quarta-feira" AutomationProperties.Name="Quarta-feira" Click="DayToggled"/>
      <ToggleButton Content="Q" Tag="4" Style="{StaticResource DayChip}" ToolTip="Quinta-feira" AutomationProperties.Name="Quinta-feira" Click="DayToggled"/>
      <ToggleButton Content="S" Tag="5" Style="{StaticResource DayChip}" ToolTip="Sexta-feira" AutomationProperties.Name="Sexta-feira" Click="DayToggled"/>
      <ToggleButton Content="S" Tag="6" Style="{StaticResource DayChip}" ToolTip="Sábado" AutomationProperties.Name="Sábado" Click="DayToggled"/>
     </StackPanel>
     <WrapPanel Margin="0,10,0,0">
      <Button Content="Dias úteis" Style="{StaticResource Pill}" Click="PickWeekdays"/>
      <Button Content="Fim de semana" Style="{StaticResource Pill}" Click="PickWeekend"/>
      <Button Content="Todos" Style="{StaticResource Pill}" Click="PickAllDays"/>
     </WrapPanel>
    </StackPanel>
    <TextBlock Text="Termina" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <ComboBox x:Name="EndMode" SelectedIndex="0" SelectionChanged="RepeatChanged" AutomationProperties.Name="Quando a repetição termina">
      <ComboBoxItem Content="Nunca"/>
      <ComboBoxItem Content="Em uma data"/>
     </ComboBox>
     <DatePicker x:Name="UntilDate" Grid.Column="1" Margin="8,0,0,0" Visibility="Collapsed" SelectedDateChanged="AlarmDateChanged" AutomationProperties.Name="Repetir até"/>
    </Grid>
   </StackPanel>
   <Border x:Name="SummaryBox" Background="{StaticResource VioletSoft}" CornerRadius="10" Padding="12,10" Margin="0,16,0,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <TextBlock Text="&#xE8EE;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Violet}" FontSize="13" Margin="0,2,9,0"/>
     <StackPanel Grid.Column="1"><TextBlock x:Name="RepeatSummary" FontSize="12.5" Foreground="{StaticResource Violet}"/><TextBlock x:Name="NextSummary" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
    </Grid>
   </Border>
  </StackPanel>

  <!-- Step 4: sound -->
  <StackPanel x:Name="SoundStep" Visibility="Collapsed">
   <Border Style="{StaticResource Card}" Padding="12,10">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource VioletSoft}"><TextBlock x:Name="MusicIcon" Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Violet}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center"><TextBlock x:Name="MusicName" Text="Som padrão" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock x:Name="MusicHint" Text="Alerta do Windows, repetido" FontSize="11.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
     <Button x:Name="PreviewMusicButton" Grid.Column="2" Content="&#xE768;" Style="{StaticResource IconButton}" ToolTip="Ouvir ou parar" AutomationProperties.Name="Ouvir ou parar música" Click="PreviewMusic"/>
     <Button Grid.Column="3" Content="&#xE711;" Style="{StaticResource IconButton}" ToolTip="Usar som padrão" AutomationProperties.Name="Usar som padrão" Click="ResetMusic"/>
    </Grid>
   </Border>
   <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button Click="ChooseMusic" Padding="10,10" AutomationProperties.Name="Escolher música"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center" Margin="0,1,8,0"/><TextBlock Text="Uma música"/></StackPanel></Button>
    <Button Grid.Column="2" Click="ChooseFolder" Padding="10,10" AutomationProperties.Name="Música aleatória de uma pasta"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center" Margin="0,1,8,0"/><TextBlock Text="Aleatória da pasta"/></StackPanel></Button>
   </Grid>
   <TextBlock Text="Resumo" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
   <Border Background="{StaticResource AccentSoft}" CornerRadius="10" Padding="12,10"><TextBlock x:Name="FinalSummary" FontSize="12.5" Foreground="{StaticResource Accent}" LineHeight="19"/></Border>
  </StackPanel>

  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2">
   <TextBlock x:Name="AlarmError" Foreground="{StaticResource Danger}" FontSize="12" Margin="20,8,20,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="20,8,20,0"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="20,12,20,14">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="DeleteButton" Content="Excluir" HorizontalAlignment="Left" Background="Transparent" Foreground="{StaticResource Danger}" Padding="8,10" Click="Delete"/>
     <Button x:Name="BackButton" Grid.Column="1" Content="Voltar" Margin="0,0,8,0" Click="Back"/>
     <Button x:Name="NextButton" Grid.Column="2" Content="Continuar" Style="{StaticResource Primary}" Padding="18,10" Click="Next"/>
     <Button x:Name="SaveButton" Grid.Column="3" Content="Salvar" Style="{StaticResource Primary}" Padding="18,10" Click="Save"/>
    </Grid>
   </Border>
  </StackPanel>
 </Grid>
</UserControl>
