<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET Framework 4.8 ships with Windows 10 and 11, so setup runs before the .NET 10 runtime exists. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ReminderSetup</AssemblyName>
    <RootNamespace>ReminderSetup</RootNamespace>
    <ApplicationIcon>../Assets/Reminder.ico</ApplicationIcon>
    <ApplicationManifest>setup.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Reminder Setup</Product>
    <Company>DarlanSchwartz</Company>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Zip of the published app, built by release.ps1. -->
    <PayloadZip Condition="'$(PayloadZip)' == ''">../.build/installer/payload.zip</PayloadZip>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp"/>
    <Reference Include="System.IO.Compression"/>
    <Reference Include="System.IO.Compression.FileSystem"/>
    <Reference Include="System.Windows.Forms"/>
    <Resource Include="../Assets/Reminder.ico" Link="Reminder.ico"/>
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip"/>
  </ItemGroup>
</Project>
