<?xml version="1.0" encoding="utf-8"?>
<!-- The app builds offline (the root NuGet.Config clears all sources). Only the tests
     need packages: xUnit and the test SDK from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
