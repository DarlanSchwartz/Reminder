<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Reminder</AssemblyName>
    <ApplicationIcon>Assets/Reminder.ico</ApplicationIcon>
    <Version>0.0.1</Version>
    <Product>Reminder</Product>
    <Company>DarlanSchwartz</Company>
  </PropertyGroup>
  <!-- The installer is a separate project. -->
  <ItemGroup><Compile Remove="Installer/**"/><Page Remove="Installer/**"/><ApplicationDefinition Remove="Installer/**"/><None Remove="Installer/**"/></ItemGroup>
  <ItemGroup><Resource Include="Assets/Reminder.ico"/></ItemGroup>
  <!-- One JSON file per language; see Localization/Loc.cs. -->
  <ItemGroup><EmbeddedResource Include="Localization/*.json" LogicalName="lang.%(Filename).json"/></ItemGroup>
  <ItemGroup><None Include="reminder.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup>
</Project>
