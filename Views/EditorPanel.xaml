<UserControl x:Class="Reminder.EditorPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Reminder" Background="{DynamicResource Canvas}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <UniformGrid x:Name="Progress" Rows="1" Margin="20,14,20,14"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,0,20,0"><StackPanel Margin="0,0,0,8">

  <!-- Step 1: the task -->
  <StackPanel x:Name="TaskStep">
   <Label Content="{local:Tr TaskName}" Target="{Binding ElementName=TitleInput}" Padding="0,0,0,6" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
   <TextBox x:Name="TitleInput" Height="40" VerticalContentAlignment="Center" MaxLength="160"/>
   <Label Content="{local:Tr DescriptionOptional}" Target="{Binding ElementName=DescriptionInput}" Padding="0" Margin="0,14,0,6" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
   <TextBox x:Name="DescriptionInput" Height="64" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000"/>
   <Label Content="{local:Tr DueOptional}" Target="{Binding ElementName=DueInput}" Padding="0" Margin="0,14,0,6" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
   <DatePicker x:Name="DueInput"/>
  </StackPanel>

  <!-- Step 2: when -->
  <StackPanel x:Name="WhenStep" Visibility="Collapsed">
   <Border Style="{StaticResource Card}" Padding="14,12">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AccentSoft}"><TextBlock Text="&#xEA8F;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource Accent}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <StackPanel Grid.Column="1" Margin="11,0" VerticalAlignment="Center"><TextBlock Text="{local:Tr RemindWithAlarm}" FontWeight="SemiBold" FontSize="13.5"/><TextBlock Text="{local:Tr RemindWithAlarmHint}" FontSize="11.5" Foreground="{DynamicResource Muted}"/></StackPanel>
     <CheckBox x:Name="AlarmEnabled" Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Center" Checked="ToggleAlarm" Unchecked="ToggleAlarm" AutomationProperties.Name="{local:Tr RemindWithAlarm}"/>
    </Grid>
   </Border>
   <StackPanel x:Name="AlarmFields" Visibility="Collapsed" Margin="0,16,0,0">
    <TextBlock Text="{local:Tr Shortcuts}" Style="{StaticResource FieldLabel}"/>
    <WrapPanel>
     <Button Content="{local:Tr InOneHour}" Style="{StaticResource Pill}" Click="QuickInHour"/>
     <Button Content="{local:Tr Tonight}" Style="{StaticResource Pill}" Click="QuickTonight"/>
     <Button Content="{local:Tr TomorrowMorning}" Style="{StaticResource Pill}" Click="QuickTomorrow"/>
    </WrapPanel>
    <TextBlock Text="{local:Tr DateAndTime}" Style="{StaticResource FieldLabel}" Margin="0,10,0,6"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
     <DatePicker x:Name="AlarmDate" SelectedDateChanged="AlarmDateChanged"/>
     <TextBox x:Name="AlarmTime" Height="38" VerticalContentAlignment="Center" TextAlignment="Center" Grid.Column="1" Text="09:00" Margin="8,0,0,0" MaxLength="5" TextChanged="AlarmTimeChanged" LostKeyboardFocus="NormalizeAlarmTime" PreviewTextInput="FilterAlarmTime" ToolTip="{local:Tr TimeTip}" AutomationProperties.Name="{local:Tr AlarmTime}"/>
    </Grid>
   </StackPanel>
  </StackPanel>

  <!-- Step 3: repeat -->
  <StackPanel x:Name="RepeatStep" Visibility="Collapsed">
   <TextBlock Text="{local:Tr Repeat}" Style="{StaticResource FieldLabel}"/>
   <ComboBox x:Name="RepeatMode" SelectedIndex="0" SelectionChanged="RepeatChanged" AutomationProperties.Name="{local:Tr Repeat}">
    <ComboBoxItem Content="{local:Tr NoRepeat}"/>
    <ComboBoxItem Content="{local:Tr Hourly}"/>
    <ComboBoxItem Content="{local:Tr Daily}"/>
    <ComboBoxItem Content="{local:Tr Weekly}"/>
    <ComboBoxItem Content="{local:Tr Monthly}"/>
    <ComboBoxItem Content="{local:Tr Yearly}"/>
   </ComboBox>
   <StackPanel x:Name="RepeatFields" Visibility="Collapsed">
    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
     <TextBlock Text="{local:Tr Every}" VerticalAlignment="Center" FontSize="13" Margin="0,0,10,0"/>
     <Button Content="&#xE738;" Style="{StaticResource IconButton}" FontSize="11" Width="32" Height="32" Click="DecreaseInterval" ToolTip="{local:Tr Less}" AutomationProperties.Name="{local:Tr IntervalDown}"/>
     <TextBox x:Name="IntervalInput" Width="54" Height="36" Text="1" TextAlignment="Center" VerticalContentAlignment="Center" MaxLength="3" Margin="4,0" PreviewTextInput="FilterDigits" TextChanged="RepeatInputChanged" AutomationProperties.Name="{local:Tr IntervalName}"/>
     <Button Content="&#xE710;" Style="{StaticResource IconButton}" FontSize="11" Width="32" Height="32" Click="IncreaseInterval" ToolTip="{local:Tr More}" AutomationProperties.Name="{local:Tr IntervalUp}"/>
     <TextBlock x:Name="IntervalUnit" Text="dias" VerticalAlignment="Center" FontSize="13" Margin="10,0,0,0"/>
    </StackPanel>
    <StackPanel x:Name="WeekFields" Visibility="Collapsed" Margin="0,14,0,0">
     <TextBlock Text="{local:Tr OnDays}" Style="{StaticResource FieldLabel}"/>
     <StackPanel x:Name="DayChips" Orientation="Horizontal">
      <ToggleButton Tag="0" Style="{StaticResource DayChip}" Click="DayToggled"/>
      <ToggleButton Tag="1" Style="{StaticResource DayChip}" Click="DayToggled"/>
      <ToggleButton Tag="2" Style="{StaticResource DayChip}" Click="DayToggled"/>
      <ToggleButton Tag="3" Style="{StaticResource DayChip}" Click="DayToggled"/>
      <ToggleButton Tag="4" Style="{StaticResource DayChip}" Click="DayToggled"/>
      <ToggleButton Tag="5" Style="{StaticResource DayChip}" Click="DayToggled"/>
      <ToggleButton Tag="6" Style="{StaticResource DayChip}" Click="DayToggled"/>
     </StackPanel>
     <WrapPanel Margin="0,10,0,0">
      <Button Content="{local:Tr Weekdays}" Style="{StaticResource Pill}" Click="PickWeekdays"/>
      <Button Content="{local:Tr Weekend}" Style="{StaticResource Pill}" Click="PickWeekend"/>
      <Button Content="{local:Tr AllDays}" Style="{StaticResource Pill}" Click="PickAllDays"/>
     </WrapPanel>
    </StackPanel>
    <TextBlock Text="{local:Tr Ends}" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <ComboBox x:Name="EndMode" SelectedIndex="0" SelectionChanged="RepeatChanged" AutomationProperties.Name="{local:Tr EndsName}">
      <ComboBoxItem Content="{local:Tr Never}"/>
      <ComboBoxItem Content="{local:Tr OnDate}"/>
     </ComboBox>
     <DatePicker x:Name="UntilDate" Grid.Column="1" Margin="8,0,0,0" Visibility="Collapsed" SelectedDateChanged="AlarmDateChanged" AutomationProperties.Name="{local:Tr RepeatUntil}"/>
    </Grid>
   </StackPanel>
   <Border x:Name="SummaryBox" Background="{DynamicResource VioletSoft}" CornerRadius="10" Padding="12,10" Margin="0,16,0,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <TextBlock Text="&#xE8EE;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource Violet}" FontSize="13" Margin="0,2,9,0"/>
     <StackPanel Grid.Column="1"><TextBlock x:Name="RepeatSummary" FontSize="12.5" Foreground="{DynamicResource Violet}"/><TextBlock x:Name="NextSummary" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/></StackPanel>
    </Grid>
   </Border>
  </StackPanel>

  <!-- Step 4: sound -->
  <StackPanel x:Name="SoundStep" Visibility="Collapsed">
   <Border Style="{StaticResource Card}" Padding="12,10">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource VioletSoft}"><TextBlock x:Name="MusicIcon" Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource Violet}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center"><TextBlock x:Name="MusicName" Text="{local:Tr DefaultSound}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock x:Name="MusicHint" Text="{local:Tr DefaultSoundHint}" FontSize="11.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
     <Button x:Name="PreviewMusicButton" Grid.Column="2" Content="&#xE768;" Style="{StaticResource IconButton}" ToolTip="{local:Tr PlayStop}" AutomationProperties.Name="{local:Tr PlayStop}" Click="PreviewMusic"/>
     <Button Grid.Column="3" Content="&#xE711;" Style="{StaticResource IconButton}" ToolTip="{local:Tr UseDefaultSound}" AutomationProperties.Name="{local:Tr UseDefaultSound}" Click="ResetMusic"/>
    </Grid>
   </Border>
   <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button Click="ChooseMusic" Padding="10,10" AutomationProperties.Name="{local:Tr ChooseSong}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center" Margin="0,1,8,0"/><TextBlock Text="{local:Tr OneSong}"/></StackPanel></Button>
    <Button Grid.Column="2" Click="ChooseFolder" Padding="10,10" AutomationProperties.Name="{local:Tr RandomFromFolderName}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center" Margin="0,1,8,0"/><TextBlock Text="{local:Tr RandomFromFolder}"/></StackPanel></Button>
   </Grid>
   <TextBlock Text="{local:Tr Summary}" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
   <Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="12,10"><TextBlock x:Name="FinalSummary" FontSize="12.5" Foreground="{DynamicResource Accent}" LineHeight="19"/></Border>
  </StackPanel>

  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2">
   <TextBlock x:Name="AlarmError" Foreground="{DynamicResource Danger}" FontSize="12" Margin="20,8,20,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="20,8,20,0"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="20,12,20,14">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="DeleteButton" Content="{local:Tr Delete}" HorizontalAlignment="Left" Background="Transparent" Foreground="{DynamicResource Danger}" Padding="8,10" Click="Delete"/>
     <Button x:Name="BackButton" Grid.Column="1" Content="{local:Tr Back}" Margin="0,0,8,0" Click="Back"/>
     <Button x:Name="NextButton" Grid.Column="2" Content="{local:Tr Continue}" Style="{StaticResource Primary}" Padding="18,10" Click="Next"/>
     <Button x:Name="SaveButton" Grid.Column="3" Content="{local:Tr Save}" Style="{StaticResource Primary}" Padding="18,10" Click="Save"/>
    </Grid>
   </Border>
  </StackPanel>
 </Grid>
</UserControl>
