<Window x:Class="Reminder.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Reminder" Title="Reminder" Style="{StaticResource {x:Type Window}}" Icon="/Assets/Reminder.ico" Width="360" Height="460" MinHeight="300" MinWidth="340" WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="True" UseLayoutRounding="True">
 <!-- Removes the dark non-client strip Windows draws above borderless resizable windows. -->
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Border x:Name="Root" BorderBrush="{StaticResource Line}" BorderThickness="1">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Padding="6,7,8,7" MouseLeftButtonDown="DragHeader">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#13917C" Offset="0"/><GradientStop Color="#0B5E52" Offset="1"/></LinearGradientBrush></Border.Background>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <!-- Segmented tabs live in the header to keep the list tall. -->
     <Border x:Name="Tabs" Grid.Column="1" Margin="6,0,8,0" Background="#26000000" CornerRadius="8" Padding="2" HorizontalAlignment="Left">
      <Grid>
       <!-- Highlight that glides to the active tab. -->
       <Border x:Name="TabPill" Background="White" CornerRadius="6" HorizontalAlignment="Left" Width="0"/>
       <StackPanel Orientation="Horizontal">
        <Button x:Name="PendingTab" Click="ShowPending" Padding="9,2" FontSize="11" BorderThickness="0" Background="Transparent" Focusable="False" FocusVisualStyle="{x:Null}"/>
        <Button x:Name="DoneTab" Click="ShowDone" Padding="9,2" FontSize="11" BorderThickness="0" Background="Transparent" Focusable="False" FocusVisualStyle="{x:Null}"/>
       </StackPanel>
      </Grid>
     </Border>
     <Button x:Name="PinButton" Grid.Column="0" Content="&#xE718;" Style="{StaticResource HeaderButton}" ToolTip="{local:Tr Pin}" AutomationProperties.Name="{local:Tr Pin}" Click="TogglePin"/>
     <Button Grid.Column="3" Content="&#xE713;" Style="{StaticResource HeaderButton}" ToolTip="{local:Tr Settings}" AutomationProperties.Name="{local:Tr Settings}" Click="Settings"/>
     <Button Grid.Column="4" Content="&#xE921;" Style="{StaticResource HeaderButton}" ToolTip="{local:Tr Hide}" AutomationProperties.Name="{local:Tr Hide}" Click="HideWidget"/>
    </Grid>
   </Border>
   <Grid Grid.Row="2">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,0,20,0"><ItemsControl x:Name="TaskList" Margin="0,14,0,8"><ItemsControl.ItemTemplate><DataTemplate>
     <Border Background="{StaticResource Surface}" CornerRadius="12" Margin="0,0,0,9" Effect="{StaticResource Lift}" Cursor="Hand">
      <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#B8CCC6"/></Trigger></Style.Triggers></Style></Border.Style>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <!-- Status stripe: red when overdue, teal with an active alarm. -->
       <Border CornerRadius="12,0,0,12">
        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding HasAlarm}" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/></DataTrigger><DataTrigger Binding="{Binding Overdue}" Value="True"><Setter Property="Background" Value="{StaticResource Danger}"/></DataTrigger></Style.Triggers></Style></Border.Style>
       </Border>
       <CheckBox Grid.Column="2" Style="{StaticResource TaskCheck}" IsChecked="{Binding Completed, Mode=OneWay}" VerticalAlignment="Top" Margin="6,11,0,0" Click="CompleteTask" ToolTip="{local:Tr ToggleDone}" AutomationProperties.Name="{local:Tr ToggleDone}"/>
       <StackPanel Grid.Column="1" Margin="14,12,4,10" MouseLeftButtonUp="EditTask" Background="Transparent">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Style.Triggers><DataTrigger Binding="{Binding Completed}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" MaxHeight="36" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,3,0,0">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <WrapPanel Margin="0,8,0,0">
         <Border Visibility="{Binding HasDue, Converter={StaticResource Visible}}">
          <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Chip}"><Style.Triggers><DataTrigger Binding="{Binding Overdue}" Value="True"><Setter Property="Background" Value="{StaticResource DangerSoft}"/><Setter Property="TextElement.Foreground" Value="{StaticResource Danger}"/></DataTrigger></Style.Triggers></Style></Border.Style>
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE787;" Style="{StaticResource ChipIcon}"/><TextBlock Text="{Binding DueLabel}" FontSize="11"/></StackPanel>
         </Border>
         <Border Style="{StaticResource Chip}" Background="{StaticResource AccentSoft}" TextElement.Foreground="{StaticResource Accent}" Visibility="{Binding HasAlarm, Converter={StaticResource Visible}}">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEA8F;" Style="{StaticResource ChipIcon}"/><TextBlock Text="{Binding AlarmLabel}" FontSize="11"/></StackPanel>
         </Border>
         <Border Style="{StaticResource Chip}" Background="{StaticResource VioletSoft}" TextElement.Foreground="{StaticResource Violet}" Visibility="{Binding IsRepeating, Converter={StaticResource Visible}}">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EE;" Style="{StaticResource ChipIcon}"/><TextBlock Text="{Binding RepeatLabel}" FontSize="11" TextWrapping="NoWrap"/></StackPanel>
         </Border>
        </WrapPanel>
       </StackPanel>
       <Button Grid.Column="3" Content="&#xE70F;" Style="{StaticResource IconButton}" FontSize="12" Margin="0,6,6,0" VerticalAlignment="Top" Click="EditTaskButton" ToolTip="{local:Tr EditTask}" AutomationProperties.Name="{local:Tr EditTask}"/>
      </Grid>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
     <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center"><TextBlock x:Name="EmptyIcon" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="22" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock x:Name="EmptyTitle" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,3"/>
     <TextBlock x:Name="EmptyText" FontSize="12" Foreground="{StaticResource Muted}" TextAlignment="Center" HorizontalAlignment="Center"/>
    </StackPanel>
   </Grid>
   <Border x:Name="EditorShade" Grid.Row="1" Grid.RowSpan="3" Panel.ZIndex="1" Visibility="Collapsed" Background="{StaticResource Canvas}"><ContentControl x:Name="EditorHost" Focusable="False"/></Border>
   <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,12,20,14">
    <Button Content="{local:Tr NewTask}" ToolTip="{local:Tr NewTask}" AutomationProperties.Name="{local:Tr NewTask}" Style="{StaticResource Primary}" Click="AddTask" Padding="0,11">
     <Button.ContentTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="12" VerticalAlignment="Center" Margin="0,1,8,0"/><TextBlock Text="{Binding}"/></StackPanel></DataTemplate></Button.ContentTemplate>
    </Button>
   </Border>
  </Grid>
 </Border>
</Window>
